#!/bin/bash
IP_SERVIDOR="149.50.147.26"
PUERTO=7777
CLAVE="$1"
IP_VPS="$2"

# Preguntamos tal cual: HOLA + CLAVE + IP
RESP=$(echo "HOLA_ESTAS_BIEN $CLAVE $IP_VPS" | nc -w 15 $IP_SERVIDOR $PUERTO | tr -cd 'A-Z_')

# Solo si contesta exactamente lo que esperamos
[[ "$RESP" == "HOLA_ESTOY_BIEN" ]] && echo "AUTORIZADO" || echo "DENEGADO"
